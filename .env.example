# Real Data Integration API Keys
# Copy this file to .env.local and fill in your API keys

# IGN Géoportail API Key
# Get your key at: https://geoservices.ign.fr/
# Free tier: 2M requests/year
NEXT_PUBLIC_IGN_API_KEY=your_ign_api_key_here

# INSEE Sirene API Credentials
# Register at: https://portail-api.insee.fr/ (new portal)
# Old URL (deprecated): https://api.insee.fr/catalogue/
# Free tier: 30 requests/minute
INSEE_CONSUMER_KEY=your_insee_consumer_key_here
INSEE_CONSUMER_SECRET=your_insee_consumer_secret_here

# Optional: OpenStreetMap Overpass API
# No API key required, but consider rate limits
# Public instance: https://overpass-api.de/api/interpreter
# Consider hosting your own instance for production: https://wiki.openstreetmap.org/wiki/Overpass_API/Installation

NODE_ENV=development
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000"

# Configuration Ollama (IA locale)
# Par défaut : http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# Modèle recommandé : mistral (7B, excellent français)
OLLAMA_MODEL=mistral
# Timeout en millisecondes
OLLAMA_TIMEOUT=30000
