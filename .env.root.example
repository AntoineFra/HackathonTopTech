# ==============================================
# Root Environment Variables
# 06 Analytics Monorepo
# ==============================================

# ===================
# Frontend (Next.js)
# ===================
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000


# Ollama Configuration (for local development without Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3:mini
OLLAMA_TIMEOUT=60000

# ===================
# Backend (Express)
# ===================
# Server
PORT=3000
NODE_ENV=development

# Database (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# API Keys (optional)
LEGAL_UNIT_URL="https://www.data.gouv.fr/api/1/datasets/r/825f4199-cadd-486c-ac46-a65a8ea1a047"
ESTABLISHMENT_URL="https://www.data.gouv.fr/api/1/datasets/r/ba6a4e4c-aac6-4764-bbd2-f80ae345afc5"

# Logging
LOG_TO_FILE=false
LOG_FILE=logs/access.log

# ===================
# IGN & INSEE APIs (Optional)
# ===================
# IGN Géoportail
NEXT_PUBLIC_IGN_API_KEY=your_ign_api_key_here

# INSEE Sirene
INSEE_CONSUMER_KEY=your_insee_consumer_key_here
INSEE_CONSUMER_SECRET=your_insee_consumer_secret_here

# ===================
# Docker Configuration
# ===================
# Note: When running with Docker Compose, URLs are different:
# - Backend: http://backend:3000
# - Ollama: http://ollama:11434
# These are automatically set in docker-compose.yml

LOCAL_TWEAK_IA=http://localhost:8001
