# Exemple d'environnement pour le projet Hackabacktek

# Base de données (SQLite par défaut dans le dépôt)
DATABASE_URL="file:./prisma/dev.db"

# Port d'écoute de l'application
PORT=3000

# Environnement (development|production)
NODE_ENV=development

# URL externe utilisée par certains services (ex: API data.gouv.fr)
LEGAL_UNIT_URL="https://www.data.gouv.fr/api/1/datasets/r/<resource-id>"

# Logging
# Mettre LOG_TO_FILE=true si vous modifiez server.ts pour écrire dans un fichier.
LOG_TO_FILE=false
LOG_FILE=logs/access.log

