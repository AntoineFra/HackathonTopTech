{
    "title": "06 Analytics Platform",
    "description": "Documentation complète de la plateforme d'analyse territoriale PACA",
    "author": "CCI Nice Côte d'Azur",
    "language": "fr",
    "gitbook": "3.x.x",
    "structure": {
        "readme": "README.md",
        "summary": "SUMMARY.md"
    },
    "plugins": [
        "github",
        "edit-link",
        "anchors",
        "search",
        "prism",
        "-highlight",
        "copy-code-button",
        "expandable-chapters",
        "back-to-top-button"
    ],
    "pluginsConfig": {
        "github": {
            "url": "https://github.com/AntoineFra/HackathonTopTech"
        },
        "edit-link": {
            "base": "https://github.com/AntoineFra/HackathonTopTech/edit/main",
            "label": "Éditer cette page"
        },
        "sharing": {
            "facebook": false,
            "twitter": true,
            "google": false,
            "all": ["linkedin", "twitter"]
        },
        "theme-default": {
            "showLevel": true,
            "styles": {
                "website": ".gitbook/styles/website.css"
            }
        }
    },
    "links": {
        "sidebar": {
            "🏠 Site principal": "http://localhost:8080",
            "🔧 API Backend": "http://localhost:3000",
            "📦 GitHub": "https://github.com/AntoineFra/HackathonTopTech"
        }
    }
}
