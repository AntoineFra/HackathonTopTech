{
    "name": "paca-analytics-monorepo",
    "version": "1.0.0",
    "description": "Monorepo PACA Analytics - Frontend (Next.js) + Backend (Express) + Ollama AI",
    "private": true,
    "packageManager": "pnpm@10.20.0",
    "scripts": {
        "dev": "docker compose up -d && turbo dev",
        "dev:frontend": "turbo dev --filter=frontend",
        "dev:backend": "turbo dev --filter=backend",
        "build": "turbo build",
        "build:frontend": "turbo build --filter=frontend",
        "build:backend": "turbo build --filter=backend",
        "start": "docker compose up -d && turbo start",
        "clean": "turbo clean && rm -rf apps/*/node_modules apps/*/.next .turbo",
        "ollama:start": "./start-ollama.sh",
        "ollama:stop": "docker compose down",
        "ollama:logs": "docker logs -f paca-ollama",
        "ollama:pull": "docker exec paca-ollama ollama pull llama2:7b-chat-q4_K_S",
        "prisma:generate": "turbo prisma:generate --filter=backend",
        "prisma:push": "turbo prisma:push --filter=backend",
        "prisma:reset": "cd apps/backend && pnpm prisma migrate reset --force",
        "prisma:all": "pnpm prisma:generate && pnpm prisma:push",
        "prisma:studio": "turbo prisma:studio --filter=backend",
        "format": "turbo format",
        "lint": "turbo lint",
        "test": "turbo test",
        "install:all": "pnpm install"
        "docs:init": "docsify init .",
        "docs:serve": "docsify serve . --port 4000",
        "docs:build": "echo 'Docsify does not need a build step'",
        "docs:pdf": "echo 'PDF generation not available with Docsify'",
        "docs:clean": "echo 'No build files to clean'"
    },
    "devDependencies": {
        "concurrently": "^9.1.2",
        "prettier": "^3.6.2",
        "turbo": "^2.6.0"
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=10.0.0"
    }
}
